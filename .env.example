# ============ AI providers ============
# Google Gemini API key -> get one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini chat model used by the agents
GEMINI_MODEL=gemini-2.5-flash
# Vision model for screen understanding (gemini-2.5-flash is multimodal)
GEMINI_VISION_MODEL=gemini-2.5-flash
# Tried when the primary vision model hits its free-tier quota -- daily
# limits are per-model, so a second model often still has quota left.
GEMINI_VISION_FALLBACK_MODEL=gemini-2.5-flash-lite

# OPTIONAL: Groq fallback -- if set, text-agent calls automatically fall
# back to Groq when Gemini fails (rate limit, outage). Also powers voice
# input (Whisper) at POST /speech/transcribe.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SPEECH_MODEL=whisper-large-v3-turbo

# ============ Embeddings ============
# "local" = HuggingFace sentence-transformer on this machine (needs torch)
# "gemini" = Gemini embedding API (no torch; use on small-RAM hosts/Docker)
EMBEDDINGS_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============ RAG tuning ============
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# ============ Uploads & screenshots ============
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
MAX_IMAGE_SIZE_MB=8
# OPTIONAL: path to the Tesseract binary for the OCR fallback (Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ============ Persistent memory ============
# PostgreSQL in production; leave unset for a local SQLite file.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/sidepilot
# Where the FAISS index + document registry are saved so uploaded
# documents survive a restart (separate from chat history, which lives
# in DATABASE_URL). Set to empty to disable disk persistence.
INDEX_DIR=data/index

# ============ Automation & integrations ============
EXPORTS_DIR=exports
# OPTIONAL: Gmail OAuth token JSON for real API drafts; without it,
# email drafts are generated as downloadable .eml files.
# GMAIL_TOKEN_JSON=

# ============ Security / limits ============
# OPTIONAL: protects /admin*, /admin/stats and DELETE /documents/{id}.
# Leave empty for an open local demo. When set, pass it back via
# "Authorization: Bearer <token>", "X-Admin-Token: <token>", or
# "/admin?token=<token>" in a browser.
ADMIN_TOKEN=
# Per-IP request limit on write/LLM routes (/ask, /upload, /screen,
# /intent, /speech) and any other mutating request.
RATE_LIMIT_REQUESTS=40
RATE_LIMIT_WINDOW=60
