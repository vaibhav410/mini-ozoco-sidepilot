
# Google Gemini API key -> get one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini chat model used by both agents
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL: Groq fallback. If set, agent calls automatically fall back to

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace sentence-transformer model used for embeddings (runs locally, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Upload limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
